    // Ensure both date fields are populated before comparing
    if (!current.from_date.nil() && !current.to_date.nil()) {
        
        var gdtFromDate = new GlideDateTime(current.from_date);
        var gdtToDate = new GlideDateTime(current.to_date);

        // compareTo returns -1 if gdtToDate is before gdtFromDate
        if (gdtToDate.compareTo(gdtFromDate) < 0) {
            gs.addErrorMessage("To Date cannot be earlier than From Date. Please correct the date range.");
            current.setAbortAction(true); // Stops the record from saving
        }
    }

})(current, previous);]]></script>
